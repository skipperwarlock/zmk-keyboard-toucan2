#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    behaviors {
        bspc_tab: bspc_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp TAB>;
            mods = <(MOD_LALT|MOD_RALT|MOD_LCTL|MOD_RCTL)>;
            keep-mods = <(MOD_LALT|MOD_RALT)>;
        };

        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        mt_fast: mod_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        mt_pos_left: mod_tap_positional_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            retro-tap;
            // D is on the left half; only keys on the right half trigger its Shift hold.
            hold-trigger-key-positions = <6 7 8 9 10 18 19 21 30 31>;
            bindings = <&kp>, <&kp>;
        };

        mt_pos_right: mod_tap_positional_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            retro-tap;
            // K is on the right half; only keys on the left half trigger its Shift hold.
            hold-trigger-key-positions = <1 2 3 4 5 13 14 16 17 25 26 27 28 29>;
            bindings = <&kp>, <&kp>;
        };

        bt0: bt0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt0_sel>, <&bt0_clr>;
        };

        bt1: bt1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt1_sel>, <&bt1_clr>;
        };

        bt2: bt2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt2_sel>, <&bt2_clr>;
        };

        bt3: bt3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt3_sel>, <&bt3_clr>;
        };

        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        td_shift_gui: td_shift_gui {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp LGUI>;
        };

        td_num: td_num {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 3>, <&to 3>;
        };

        sk_quick: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
        };

        mt_gui_sk: mod_tap_gui_sticky_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&sk_quick>;
        };

        td_gui_nav: td_gui_nav {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt_gui_sk LGUI LSHFT>, <&to 2>;
        };
    };

    macros {
        bt0_sel: bt0_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };

        bt0_clr: bt0_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        bt1_sel: bt1_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
        };

        bt1_clr: bt1_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
        };

        bt2_sel: bt2_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;
        };

        bt2_clr: bt2_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;
        };

        bt3_sel: bt3_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>;
        };

        bt3_clr: bt3_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_CLR>;
        };

        d_space: d_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D>, <&kp SPACE>;
        };

        k_space: k_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp SPACE>;
        };
    };

    // Combos use key-positions = 0-based slot index in each layer's bindings (same order as
    // boards/shields/toucan/toucan.dtsi default_transform). BASE row 2: 14 S, 15 D, ... 19 J, 20 K, 21 L.
    // Row 3: 24 caps, 25 Z, 26 X, 27 C, ...
    combos {
        compatible = "zmk,combos";

        // Press both home-row Shift keys (D + K) to enable Caps Word.
        combo_dk_caps_word {
            timeout-ms = <50>;
            key-positions = <15 20>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        combo_d_space {
            timeout-ms = <280>;
            key-positions = <15 40>;
            bindings = <&d_space>;
            layers = <BASE>;
        };

        combo_k_space {
            timeout-ms = <280>;
            key-positions = <20 40>;
            bindings = <&k_space>;
            layers = <BASE>;
        };

        combo_we_slash {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp FSLH>;
            layers = <BASE>;
        };

        combo_er_backslash {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp BSLH>;
            layers = <BASE>;
        };

        // Hold I and O together to enable the mouse movement layer.
        combo_io_mouse {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&mo 4>;
            layers = <BASE>;
        };

//        combo_sd_tab {
//            timeout-ms = <50>;
//            key-positions = <14 15>;
//            bindings = <&kp TAB>;
//            layers = <0>;
//        };

//        combo_jk_fslh {
//            timeout-ms = <50>;
//            key-positions = <19 20>;
//            bindings = <&kp FSLH>;
//            layers = <0>;
//        };

//        combo_kl_bslh {
//            timeout-ms = <50>;
//            key-positions = <20 21>;
//            bindings = <&kp BSLH>;
//            layers = <0>;
//        };

        combo_xc_copy {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        combo_cv_paste {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp LC(V)>;
            layers = <0>;
        };

        combo_xv_cut {
            timeout-ms = <50>;
            key-positions = <26 28>;
            bindings = <&kp LC(X)>;
            layers = <0>;
        };

        combo_ui_esc {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
                &kp GRAVE     &kp Q                  &kp W                  &kp E                  &kp R                  &mt DEL T                &mt PSCRN Y            &kp U                  &kp I                  &kp O                  &kp P                 &kp BSLH
                &kp TAB                &kp A                  &mt LALT S             &mt_pos_left LSHFT D   &mt LCTRL F            &kp G                    &kp H                  &mt RCTRL J            &mt_pos_right RSHFT K  &mt RALT L             &lt 1 SEMI            &kp SQT
                &td_shift_caps         &kp Z                  &kp X                  &kp C                  &kp V                  &kp B                    &kp N                  &kp M                  &kp COMMA              &kp DOT                &kp FSLH              &kp RSHFT
                &td_gui_nav            &td_num                &bspc_tab              &kp RET                &kp SPACE              &kp DEL
            >;
        };

        layer_1 {
            display-name = "DEV";
            bindings = <
                &trans                 &trans                 &kp GRAVE              &kp MINUS              &kp EQUAL              &kp LS(COMMA)            &kp LPAR               &kp LBKT               &kp UP                 &kp RBKT               &trans                 &trans
                &trans                 &td_shift_gui          &mt LALT EXCL          &mt LSHFT LS(BSLH)     &mt LCTRL AMPS         &kp LS(DOT)              &kp RPAR               &kp LEFT               &kp DOWN               &kp RIGHT              &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &trans                 &trans                 &trans                 &trans                 &trans
                &kp PG_UP              &kp FSLH               &kp BSLH               &kp HOME               &kp END                &kp PG_DN
            >;
        };

        layer_2 {
            display-name = "NAV";
            bindings = <
                &bt0                   &bt1                   &bt2                   &bt3                   &trans                 &bt BT_CLR               &kp PG_UP              &trans                 &trans                 &trans                 &trans                 &kp C_VOL_UP
                &trans                 &trans                 &kp LALT               &kp LSHFT              &kp LCTRL              &trans                   &kp LEFT               &kp DOWN               &kp UP                 &kp RIGHT              &trans                 &kp C_VOL_DN
                &to 3                  &studio_unlock         &trans                 &trans                 &trans                 &trans                   &kp PG_DN              &trans                 &trans                 &trans                 &trans                 &kp C_MUTE
                &to 0                  &mkp LCLK              &mkp RCLK              &kp HOME               &kp END                &none
            >;
        };

        layer_3 {
            display-name = "NUM";
            bindings = <
                &kp ESC                &none                 &kp F7                 &kp F8                 &kp F9                 &kp F10                  &none               &kp N7                 &kp N8                 &kp N9                 &kp STAR               &kp EQUAL
                &kp TAB                &none                 &mt LALT F4            &mt LSHFT F5           &mt LCTRL F6           &kp F11                  &none               &mt RALT N4            &mt RSHFT N5           &mt RCTRL N6           &kp PLUS                &kp MINUS
                &trans                 &none                 &kp F1                 &kp F2                 &kp F3                 &kp F12                  &none               &kp N1                 &kp N2                 &kp N3                 &kp DOT                &kp FSLH
                &trans                 &to 0                  &trans                 &trans                 &trans                 &kp N0
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &mmv MOVE_UP &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &to 0    &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        layer_5 {
            display-name = "SYM";
            bindings = <
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &kp GRAVE              &kp AMPS               &kp STAR               &kp LPAR               &kp RPAR                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &kp DLLR               &kp PRCNT              &kp CARET              &trans                 &trans
                &trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &trans                 &kp EXCL               &kp AT                 &kp HASH               &trans                 &trans
                &trans                 &trans                 &trans                   &trans                 &trans                 &trans
            >;
        };
    };
};
